# Next.js（frontend）が読む値。値は入れない（キー名のみ）。
#
# 使い方:
#   cp frontend/.env.example frontend/.env.local
#
# NEXT_PUBLIC_ を付けるとブラウザに露出する。いずれにも付けない
# （docs/architecture.md「設定と環境変数」 / docs/security.md）。
#
# リポジトリ直下の .env は Next.js からは読まれない。backend 用である。

# Spring Boot への接続。ブラウザから直接叩かせないため公開しない
BACKEND_BASE_URL=
BACKEND_API_KEY=
# 管理 API 用。管理者セッションの検証に成功したときだけ使う
BACKEND_ADMIN_API_KEY=

# セッション Cookie の署名・暗号化鍵
SESSION_SECRET=

# true でサイト全体を停止する（LR-05 / ADR-0013）
SITE_DISABLED=
