# 値は入れない。キー名だけを置く（docs/architecture.md 第 7 章）。
# 実際の値は .env に書き、.env は .gitignore で除外されている。

# ---- Next.js（Vercel）----
# NEXT_PUBLIC_ を付けるとブラウザに露出する。いずれにも付けないこと。
BACKEND_BASE_URL=
BACKEND_API_KEY=
BACKEND_ADMIN_API_KEY=
SESSION_SECRET=
SITE_DISABLED=

# ---- Spring Boot（Fly.io Secrets）----
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
X_BEARER_TOKEN=
X_SOURCE_USERNAME=
ADMIN_PASSWORD_HASH=
INTERNAL_API_KEY=
INTERNAL_ADMIN_API_KEY=
