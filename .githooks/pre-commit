#!/bin/sh
# main 上で直接コミットするのを止める（CLAUDE.md の Git 運用）。
# PR 経由の取り込みでは main へのマージは GitHub 側で行われるため、
# ローカルの main にコミットが積まれることはない。

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
if [ "$branch" = "main" ]; then
    echo "pre-commit: main への直接コミットは禁止（CLAUDE.md の Git 運用）" >&2
    echo "  git checkout -b feat/xxx  で作業ブランチを切ってください" >&2
    exit 1
fi
exit 0
